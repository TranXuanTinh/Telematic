[Unit]
Description=TCU Built-In Self-Test (BIST), DTC Store & ISO 14229 UDS Diagnostics Daemon
PartOf=tcu-telematics.target
Requires=tcu-mcu-ipcd.service tcu-platformd.service
After=tcu-mcu-ipcd.service tcu-platformd.service

[Service]
Type=notify
User=tcu
Group=tcu
ExecStart=/usr/bin/tcu-diagd --config /etc/tcu/tcu_config.yaml --runtime-dir /run/tcu
Restart=always
RestartSec=2
WatchdogSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/tcu /data
ReadOnlyPaths=/factory

[Install]
WantedBy=tcu-telematics.target

