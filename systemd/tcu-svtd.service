[Unit]
Description=TCU Stolen Vehicle Tracking & Zero-Speed Safe Immobilizer Daemon
PartOf=tcu-telematics.target
Requires=tcu-mcu-ipcd.service tcu-platformd.service
After=tcu-mcu-ipcd.service tcu-platformd.service

[Service]
Type=notify
User=tcu
Group=tcu
ExecStart=/usr/bin/tcu-svtd --config /etc/tcu/tcu_config.yaml --runtime-dir /run/tcu
Restart=always
RestartSec=2
WatchdogSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/tcu /data

[Install]
WantedBy=tcu-telematics.target

